<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: awful throneroom -->
  <ReignedInThroneroom.stages.awful_throneroom.label>berbat taht odası</ReignedInThroneroom.stages.awful_throneroom.label>
  <!-- EN: I had to reign in an awful throneroom. It's like a deliberate insult from my inferiors. -->
  <ReignedInThroneroom.stages.awful_throneroom.description>Berbat bir taht odasında hüküm sürmek zorunda kaldım. Sanki astlarımdan bilinçli bir hakaret.</ReignedInThroneroom.stages.awful_throneroom.description>
  <!-- EN: dull throneroom -->
  <ReignedInThroneroom.stages.dull_throneroom.label>sıkıcı taht odası</ReignedInThroneroom.stages.dull_throneroom.label>
  <!-- EN: I had to reign in a dull throneroom. It clearly diminished my stature. -->
  <ReignedInThroneroom.stages.dull_throneroom.description>Sıkıcı bir taht odasında hüküm sürmek zorunda kaldım. Saygınlığımı açıkça zedeledi.</ReignedInThroneroom.stages.dull_throneroom.description>
  <!-- EN: mediocre throneroom -->
  <ReignedInThroneroom.stages.mediocre_throneroom.label>vasat taht odası</ReignedInThroneroom.stages.mediocre_throneroom.label>
  <!-- EN: I had to reign in a mediocre throneroom. It didn't express my stature. -->
  <ReignedInThroneroom.stages.mediocre_throneroom.description>Vasat bir taht odasında hüküm sürmek zorunda kaldım. Saygınlığımı yansıtmadı.</ReignedInThroneroom.stages.mediocre_throneroom.description>
  <!-- EN: very impressive throneroom -->
  <ReignedInThroneroom.stages.very_impressive_throneroom.label>çok etkileyici taht odası</ReignedInThroneroom.stages.very_impressive_throneroom.label>
  <!-- EN: I reigned in a very impressive throneroom. It expressed noticeable stature. -->
  <ReignedInThroneroom.stages.very_impressive_throneroom.description>Çok etkileyici bir taht odasında hüküm sürdüm. Kayda değer bir saygınlık yansıttı.</ReignedInThroneroom.stages.very_impressive_throneroom.description>
  <!-- EN: extremely impressive throneroom -->
  <ReignedInThroneroom.stages.extremely_impressive_throneroom.label>son derece etkileyici taht odası</ReignedInThroneroom.stages.extremely_impressive_throneroom.label>
  <!-- EN: I reigned in an extremely impressive throneroom. It effectively demonstrated my stature. -->
  <ReignedInThroneroom.stages.extremely_impressive_throneroom.description>Son derece etkileyici bir taht odasında hüküm sürdüm. Saygınlığımı etkili biçimde gösterdi.</ReignedInThroneroom.stages.extremely_impressive_throneroom.description>
  <!-- EN: unbelievably impressive throneroom -->
  <ReignedInThroneroom.stages.unbelievably_impressive_throneroom.label>inanılmaz etkileyici taht odası</ReignedInThroneroom.stages.unbelievably_impressive_throneroom.label>
  <!-- EN: I reigned in an unbelievably impressive throneroom. The commoners will be amazed at my highness. -->
  <ReignedInThroneroom.stages.unbelievably_impressive_throneroom.description>İnanılmaz etkileyici bir taht odasında hüküm sürdüm. Halk, yüceliğime hayran kalacak.</ReignedInThroneroom.stages.unbelievably_impressive_throneroom.description>
  <!-- EN: wondrously impressive throneroom -->
  <ReignedInThroneroom.stages.wondrously_impressive_throneroom.label>harikulade taht odası</ReignedInThroneroom.stages.wondrously_impressive_throneroom.label>
  <!-- EN: I reigned in a heavenly throneroom. It matched my grace and nobility. -->
  <ReignedInThroneroom.stages.wondrously_impressive_throneroom.description>Cennet gibi bir taht odasında hüküm sürdüm. Zarafetime ve asaletime yakışıyordu.</ReignedInThroneroom.stages.wondrously_impressive_throneroom.description>
  
</LanguageData>