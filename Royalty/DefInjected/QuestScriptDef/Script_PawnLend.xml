    <li>pawnListHaveConjugation(colonistsToLendCount>1)->have</li> -->

  <PawnLend.questDescriptionRules.rulesStrings>
    <li>questDescription(asker_factionLeader==True)->[asker_faction_name] hizbinden [asker_faction_leaderTitle] [asker_nameFull], şu işe yardım edecek fazladan ellere ihtiyaç duyuyor: [dutyDescription].\n\n[asker_pronoun], [lendForDays] gün süreyle ona yardım etmeleri için [colonistCountToLend] ödünç vermeni istiyor.\n\n[willSendShuttle]</li>
    <li>disease->grip</li>
    <li>disease->veba</li>
    <li>disease->sıtma</li>
    <li>disease->enfeksiyon</li>
    <li>questDescription(asker_royalInCurrentFaction==True)->[asker_faction_name] hizbinden [asker_royalTitleInCurrentFaction] [asker_nameFull], şu işe yardım edecek insanlara ihtiyaç duyuyor: [dutyRoyalDescription].\n\n[asker_pronoun], [lendForDays] gün süreyle ona hizmet etmeleri için [colonistCountToLend] ödünç vermeni istiyor.\n\n[willSendShuttle]</li>
    <li>colonistCountToLend(colonistsToLendCount==1)->1 kolonist[minAgeOrOlder]</li>
    <li>colonistCountToLend(colonistsToLendCount>1)->[colonistsToLendCount] kolonist[minAgeOrOlder]</li>
    <li>willSendShuttle->[asker_pronoun] [colonists] almak için bir mekik gönderecek.</li>
    <li>colonists(colonistsToLendCount==1)->kolonisti</li>
    <li>colonists(colonistsToLendCount>1)->kolonistleri</li>
    <li>minAgeOrOlder(minAge==0)-></li>
    <li>minAgeOrOlder(minAge>0)-> ([minAge] yaş ve üzeri)</li>
    <li>pawnListHaveConjugation(colonistsToLendCount==1)-></li>
    <li>pawnListHaveConjugation(colonistsToLendCount>1)->ler</li>
  </PawnLend.questDescriptionRules.rulesStrings>

