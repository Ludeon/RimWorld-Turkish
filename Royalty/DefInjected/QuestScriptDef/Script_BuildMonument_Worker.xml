<LanguageData>

  <!-- EN: Monument completed -->

  <BuildMonumentWorker.LetterLabelMonumentConstructed.slateRef>Anıt tamamlandı</BuildMonumentWorker.LetterLabelMonumentConstructed.slateRef>

