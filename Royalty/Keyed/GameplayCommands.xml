<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- EN: Choose a new heir for {HOLDER_nameIndef}: -->
  <ChooseHeir>{HOLDER_nameIndef} için yeni bir varis seç:</ChooseHeir>
  <!-- EN: You're about to change the heir of the title {HOLDER_nameIndef} received from {0_name}. This requires building a monument in a limited time, to consecrate the new inheritance. -->
  <MakeHeirConfirm>{HOLDER_nameIndef} adlı kişinin {0_name} hizbinden aldığı unvanın varisini değiştirmek üzeresin. Bu, yeni mirası kutsamak için sınırlı bir sürede bir anıt inşa etmeyi gerektirir.</MakeHeirConfirm>
  <!-- EN: This will upset {HOLDER_possessive} current heir {HEIR_nameFull}. -->
  <MakeHeirPreviousHeirWarning>Bu, şu anki varis {HEIR_nameFull} adlı kişiyi üzecek.</MakeHeirPreviousHeirWarning>
  <!-- EN: Call aid... -->
  <CommandCallRoyalAid>Yardım çağır...</CommandCallRoyalAid>
  <!-- EN: Call for aid using a special permit.\n\nEach type of aid may be used for free once, after which you must wait to use it for free again. You can use the aid more frequently, but it costs honor to do so. -->
  <CommandCallRoyalAidDesc>Özel bir yetki kullanarak yardım çağır.\n\nHer yardım türü bir kez ücretsiz kullanılabilir; ardından yeniden ücretsiz kullanmak için beklemen gerekir. Yardımı daha sık kullanabilirsin, ancak bunun bedeli onurdur.</CommandCallRoyalAidDesc>
  <!-- EN: Guests will not use their aid permits. -->
  <CommandCallRoyalAidLodger>Misafirler yardım yetkilerini kullanmaz.</CommandCallRoyalAidLodger>
  <!-- EN: Slaves cannot use their permits. -->
  <CommandCallRoyalAidSlave>Köleler yetkilerini kullanamaz.</CommandCallRoyalAidSlave>
  <!-- EN: Your relations with {FACTION_name} are hostile. -->
  <CommandCallRoyalAidFactionHostile>{FACTION_name} ile ilişkilerin düşmanca.</CommandCallRoyalAidFactionHostile>
  <!-- EN: Free -->
  <CommandCallRoyalAidFreeOption>Ücretsiz</CommandCallRoyalAidFreeOption>
  <!-- EN: {0} days left, costs {1} {FACTION_royalFavorLabel} -->
  <CommandCallRoyalAidFavorOption>{0} gün kaldı, bedeli {1} {FACTION_royalFavorLabel}</CommandCallRoyalAidFavorOption>
  <!-- EN: You are about to call for aid, but there are people from factions whom {0_name} is not hostile to. Any soldiers you call will not attack them: {1} -->
  <CommandCallRoyalAidWarningNonHostileFactions>Yardım çağırmak üzeresin, ancak {0_name} hizbinin düşman olmadığı hiziplerden insanlar var. Çağırdığın askerler onlara saldırmaz: {1}</CommandCallRoyalAidWarningNonHostileFactions>
  <!-- EN: Not enough honor. -->
  <CommandCallRoyalAidNotEnoughFavor>Yeterli onur yok.</CommandCallRoyalAidNotEnoughFavor>
  <!-- EN: {FACTION_name} cannot reach this area. -->
  <CommandCallRoyalAidMapUnreachable>{FACTION_name} bu alana ulaşamaz.</CommandCallRoyalAidMapUnreachable>
  <!-- EN: Cannot call aid here. -->
  <CommandCallRoyalAidInvalidMap>Burada yardım çağrılamaz.</CommandCallRoyalAidInvalidMap>
  <!-- EN: Call laborers -->
  <CommandCallLaborers>İşçi çağır</CommandCallLaborers>
  <!-- EN: Use a special permit to call for a group of laborers from your ally. These workers can only do labor tasks, but you can control them like they were your own colonists. You are required to keep them safe. -->
  <CommandCallLaborersDesc>Müttefikinden bir grup işçi çağırmak için özel bir yetki kullan. Bu işçiler yalnızca bedensel işler yapabilir, ama onları kendi kolonistlerin gibi yönetebilirsin. Onları güvende tutmakla yükümlüsün.</CommandCallLaborersDesc>
  <!-- EN: On cooldown. {0} days left. -->
  <CommandOnCooldown>Bekleme süresinde. {0} gün kaldı.</CommandOnCooldown>
  <!-- EN: {0} laborers -->
  <CommandCallLaborersNumLaborers>{0} işçi</CommandCallLaborersNumLaborers>
  <!-- EN: Neural heat would overflow. Disable the neural heat limiter to cast. -->
  <CommandPsycastWouldExceedEntropy>Sinirsel ısı taşar. Büyüyü yapmak için sinirsel ısı sınırlayıcısını kapat.</CommandPsycastWouldExceedEntropy>
  <!-- EN: {PSYCASTNAME} consumes {0} psyfocus but {CASTERNAME} only has {1}. -->
  <CommandPsycastNotEnoughPsyfocus>{PSYCASTNAME} {0} psiodak harcıyor, ancak {CASTERNAME} yalnızca {1} psiodağa sahip.</CommandPsycastNotEnoughPsyfocus>
  <!-- EN: {PSYCASTNAME} needs {0} psyfocus to stop {1}'s mental break but {CASTERNAME} only has {2} psyfocus. -->
  <CommandPsycastNotEnoughPsyfocusForMentalBreak>{PSYCASTNAME}, {1} adlı kişinin zihinsel çöküşünü durdurmak için {0} psiodak gerektiriyor, ancak {CASTERNAME} yalnızca {2} psiodağa sahip.</CommandPsycastNotEnoughPsyfocusForMentalBreak>
  <!-- EN: level {0} psylink is required. -->
  <CommandPsycastHigherLevelPsylinkRequired>{0}. seviye psibağ gerekli.</CommandPsycastHigherLevelPsylinkRequired>
  <!-- EN: Zero psychic sensitivity. -->
  <CommandPsycastZeroPsychicSensitivity>Psişik duyarlılık sıfır.</CommandPsycastZeroPsychicSensitivity>
  <!-- EN: Ability user is unconscious. -->
  <CommandPsycastPawnIsUnconscious>Yeteneği kullanan kişi baygın.</CommandPsycastPawnIsUnconscious>
  <!-- EN: Need at least {0} psyfocus to cast this. -->
  <CommandPsycastLowPsyfocus>Bunu yapmak için en az {0} psiodak gerekli.</CommandPsycastLowPsyfocus>
  <!-- EN: Psychic insanity immune. -->
  <CommandPsycastInsanityImmune>Psişik deliliğe bağışık.</CommandPsycastInsanityImmune>
  <!-- EN: H -->
  <NeuralHeatLetter>I</NeuralHeatLetter>
  <!-- EN: P -->
  <PsyfocusLetter>P</PsyfocusLetter>
  <!-- EN: Psychic insanity immune -->
  <IneffectivePsychicImmune>Psişik deliliğe bağışık</IneffectivePsychicImmune>
  <!-- EN: Select monument -->
  <CommandSelectMonumentMarker>Anıtı seç</CommandSelectMonumentMarker>
  <!-- EN: Select the monument marker this belongs to. -->
  <CommandSelectMonumentMarkerDesc>Bunun ait olduğu anıt işaretçisini seç.</CommandSelectMonumentMarkerDesc>
  <!-- EN: Build radius warning -->
  <CommandWarnInBuildingRadius>İnşa yarıçapı uyarısı</CommandWarnInBuildingRadius>
  <!-- EN: If enabled, this object will draw a red line to buildings you are placing using the architect menu, if they would interfere with meditation due to being too close.\n\nYou can turn this off if you don't intend to use this for meditation. -->
  <CommandWarnInBuildingRadiusDesc>Etkinse bu nesne, mimari menüsüyle yerleştirdiğin yapılar çok yakın oldukları için meditasyonu engelleyecekse onlara kırmızı bir çizgi çeker.\n\nBunu meditasyon için kullanmayı düşünmüyorsan kapatabilirsin.</CommandWarnInBuildingRadiusDesc>
  <!-- EN: Choose permit -->
  <ChooseRoyalPermit>Yetki seç</ChooseRoyalPermit>
  <!-- EN: Open the permit selection screen and choose a new permit. -->
  <ChooseRoyalPermit_Desc>Yetki seçim ekranını aç ve yeni bir yetki seç.</ChooseRoyalPermit_Desc>
  <!-- EN: Leave bestowing ceremony -->
  <CommandLeaveBestowingCeremony>Unvan verme töreninden ayrıl</CommandLeaveBestowingCeremony>
  <!-- EN: Stop participating in the bestowing ceremony. -->
  <CommandLeaveBestowingCeremonyDesc>Unvan verme törenine katılmayı bırak.</CommandLeaveBestowingCeremonyDesc>
  <!-- EN: Cancel bestowing ceremony -->
  <CommandCancelBestowingCeremony>Unvan verme törenini iptal et</CommandCancelBestowingCeremony>
  <!-- EN: End the bestowing ceremony immediately. The bestower will leave, but another opportunity to perform the ceremony will arise soon. -->
  <CommandCancelBestowingCeremonyDesc>Unvan verme törenini hemen bitir. Unvan verici ayrılacak, ancak töreni gerçekleştirmek için yakında başka bir fırsat çıkacak.</CommandCancelBestowingCeremonyDesc>
  <!-- EN: Are you sure you want to cancel bestowing ceremony? -->
  <CommandCancelBestowingCeremonyConfirm>Unvan verme törenini iptal etmek istediğinden emin misin?</CommandCancelBestowingCeremonyConfirm>

</LanguageData>
