<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- EN: Shuttle could not land on pad: {0} -->
  <ShuttleBlocked>Mekik iniş pistine inemedi: {0}</ShuttleBlocked>
  <!-- EN: The shuttle arrived, but since there were no colonists inside, the contents were lost. -->
  <MessageShuttleArrivedContentsLost>Mekik vardı, ancak içinde hiç kolonist olmadığından içindekiler kayboldu.</MessageShuttleArrivedContentsLost>
  <!-- EN: Cannot land in undiscovered area. -->
  <ShuttleCannotLand_Fogged>Keşfedilmemiş alana inilemez.</ShuttleCannotLand_Fogged>
  <!-- EN: Area must be walkable. -->
  <ShuttleCannotLand_Unwalkable>Alan yürünebilir olmalı.</ShuttleCannotLand_Unwalkable>
  <!-- EN: Terrain does not support {0}. -->
  <ShuttleCannotLand_Unaffordable>Zemin, {0} için uygun değil.</ShuttleCannotLand_Unaffordable>
  <!-- EN: Select {BESTOWER_definite} and click 'Begin bestowing ceremony' to commence the ceremony. -->
  <MessageBestowerWaiting>Töreni başlatmak için unvan vericiyi ({BESTOWER_definite}) seç ve 'Unvan verme törenini başlat' düğmesine tıkla.</MessageBestowerWaiting>
  <!-- EN: Cannot reach bestower! -->
  <MessageBestowerUnreachable>Unvan vericiye ulaşılamıyor!</MessageBestowerUnreachable>
  <!-- EN: {0} is busy. -->
  <MessageBestowingTargetIsBusy>{0} meşgul.</MessageBestowingTargetIsBusy>
  <!-- EN: The bestower is annoyed with the interference and has decided to leave. -->
  <MessageBestowingSpotUnreachable>Unvan verici müdahaleden rahatsız oldu ve ayrılmaya karar verdi.</MessageBestowingSpotUnreachable>
  <!-- EN: The bestower is leaving due to life-threatening danger. -->
  <MessageBestowingDanger>Unvan verici hayati tehlike nedeniyle ayrılıyor.</MessageBestowingDanger>
  <!-- EN: The bestower is leaving due to life-threatening temperature. -->
  <MessageBestowingDangerTemperature>Unvan verici hayati tehlike oluşturan sıcaklık nedeniyle ayrılıyor.</MessageBestowingDangerTemperature>
  <!-- EN: The bestower is leaving due to dangerous gases in the area. -->
  <MessageBestowingDangerGas>Unvan verici bölgedeki tehlikeli gazlar nedeniyle ayrılıyor.</MessageBestowingDangerGas>
  <!-- EN: The bestowing ceremony has been interrupted. -->
  <MessageBestowingInterrupted>Unvan verme töreni yarıda kesildi.</MessageBestowingInterrupted>
  <!-- EN: {PAWN_definite}'s bestowing ceremony has begun. -->
  <MessageBestowingCeremonyStarted>Unvan verme töreni başladı: {PAWN_definite}</MessageBestowingCeremonyStarted>
  <!-- EN: You defeated the {FACTION_pawnsPlural}! Get back on the shuttle to launch it. -->
  <MessageMissionGetBackToShuttle>{FACTION_pawnsPlural} grubunu yendin! Mekiği fırlatmak için mekiğe geri dön.</MessageMissionGetBackToShuttle>
  <!-- EN: {FACTION_name} has dropped resources nearby. -->
  <MessagePermitTransportDrop>{FACTION_name} yakınlara kaynak indirdi.</MessagePermitTransportDrop>
  <!-- EN: {FACTION_name} has sent resources to {PAWN_nameDef}'s caravan. -->
  <MessagePermitTransportDropCaravan>{FACTION_name}, {PAWN_nameDef} adlı kişinin kervanına kaynak gönderdi.</MessagePermitTransportDropCaravan>
  <!-- EN: No orbiting mechanoids found. -->
  <MessageNoFactionForVerbMechCluster>Yörüngede mekanoid bulunamadı.</MessageNoFactionForVerbMechCluster>

</LanguageData>
