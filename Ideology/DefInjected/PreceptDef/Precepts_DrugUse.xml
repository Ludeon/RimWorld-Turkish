<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: medical only -->
  <DrugUse_MedicalOnly.label>yalnızca tıbbi</DrugUse_MedicalOnly.label>
  <!-- EN: Poisoning the body for recreational purposes is a deeply immoral act. -->
  <DrugUse_MedicalOnly.description>Bedeni eğlence amacıyla zehirlemek son derece ahlaksız bir eylemdir.</DrugUse_MedicalOnly.description>
  <!-- EN: Ingest recreational drug -->
  <DrugUse_MedicalOnly.comps.2.description>Keyif verici uyuşturucu al</DrugUse_MedicalOnly.comps.2.description>
  <!-- EN: Administer recreational drug -->
  <DrugUse_MedicalOnly.comps.5.description>Keyif verici uyuşturucu ver</DrugUse_MedicalOnly.comps.5.description>
  
  <!-- EN: medical or social only -->
  <DrugUse_MedicalOrSocial.label>yalnızca tıbbi ya da sosyal</DrugUse_MedicalOrSocial.label>
  <!-- EN: A drink with a smoke is fine, especially with friends, but poisoning the body with powerful chemicals is wrong. -->
  <DrugUse_MedicalOrSocial.description>Bir içkiyle bir tütün, özellikle dostlarla birlikteyken sorun değildir; ama bedeni güçlü kimyasallarla zehirlemek yanlıştır.</DrugUse_MedicalOrSocial.description>
  <!-- EN: Ingest hard drug -->
  <DrugUse_MedicalOrSocial.comps.2.description>Sert uyuşturucu al</DrugUse_MedicalOrSocial.comps.2.description>
  <!-- EN: Administer hard drug -->
  <DrugUse_MedicalOrSocial.comps.5.description>Sert uyuşturucu ver</DrugUse_MedicalOrSocial.comps.5.description>
  
  <!-- EN: prohibited -->
  <DrugUse_Prohibited.label>yasak</DrugUse_Prohibited.label>
  <!-- EN: The body should absolutely not be poisoned by chemicals. The only exception is the use of medicine in direct medical care. -->
  <DrugUse_Prohibited.description>Beden kimyasallarla kesinlikle zehirlenmemelidir. Tek istisna, doğrudan tıbbi bakımda ilaç kullanımıdır.</DrugUse_Prohibited.description>
  <!-- EN: Ingest drug -->
  <DrugUse_Prohibited.comps.0.description>Uyuşturucu al</DrugUse_Prohibited.comps.0.description>
  <!-- EN: Administer drug -->
  <DrugUse_Prohibited.comps.5.description>Uyuşturucu ver</DrugUse_Prohibited.comps.5.description>
  
</LanguageData>