  <!-- EN: required -->
  <Execution_Required.label>gerekli</Execution_Required.label>
  <!-- EN: Prisoners must be executed on a regular basis. When they are, it is a happy occasion. -->
  <Execution_Required.description>Mahkûmlar düzenli olarak infaz edilmelidir. İnfaz edildiklerinde bu mutlu bir olaydır.</Execution_Required.description>
  <!-- EN: Executed prisoner -->
  <Execution_Required.comps.2.description>Mahkûmu infaz etti</Execution_Required.comps.2.description>
  <!-- EN: Responsible for prisoner death -->
  <Execution_Required.comps.3.description>Mahkûmun ölümünden sorumlu</Execution_Required.comps.3.description>
