<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: always abhorrent -->
  <Execution_Abhorrent.label>her zaman iğrenç</Execution_Abhorrent.label>
  <!-- EN: Executing a prisoner is an abhorrent evil under any circumstances. -->
  <Execution_Abhorrent.description>Bir mahkûmu infaz etmek, hangi koşulda olursa olsun iğrenç bir kötülüktür.</Execution_Abhorrent.description>
  <!-- EN: Executed prisoner -->
  <Execution_Abhorrent.comps.2.description>Mahkûmu infaz etti</Execution_Abhorrent.comps.2.description>
  <!-- EN: Responsible for prisoner death -->
  <Execution_Abhorrent.comps.3.description>Mahkûmun ölümünden sorumlu</Execution_Abhorrent.comps.3.description>
  <!-- EN: Someone executed a colonist -->
  <Execution_Abhorrent.comps.4.description>Biri bir kolonisti infaz etti</Execution_Abhorrent.comps.4.description>
  <!-- EN: Someone executed a guest -->
  <Execution_Abhorrent.comps.5.description>Biri bir misafiri infaz etti</Execution_Abhorrent.comps.5.description>
  <!-- EN: Someone executed a prisoner -->
  <Execution_Abhorrent.comps.6.description>Biri bir mahkûmu infaz etti</Execution_Abhorrent.comps.6.description>
  
  <!-- EN: don't care -->
  <Execution_DontCare.label>umursamaz</Execution_DontCare.label>
  <!-- EN: Executing prisoners is acceptable, whether they are guilty or innocent. -->
  <Execution_DontCare.description>Mahkûmları infaz etmek, suçlu ya da masum olsunlar, kabul edilebilir.</Execution_DontCare.description>
  
  <!-- EN: always horrible -->
  <Execution_Horrible.label>her zaman korkunç</Execution_Horrible.label>
  <!-- EN: Executing a prisoner is a horrible thing under any circumstances. -->
