  <!-- EN: blinding ceremony -->
  <BlindingCeremony_Know_Horrible.stages.blinding_ceremony.label>kör etme töreni</BlindingCeremony_Know_Horrible.stages.blinding_ceremony.label>
  <!-- EN: We blinded someone over ideoligious beliefs! This is wrong! -->
  <BlindingCeremony_Know_Horrible.stages.blinding_ceremony.description>İdeodinî inançlar yüzünden birini kör ettik! Bu yanlış!</BlindingCeremony_Know_Horrible.stages.blinding_ceremony.description>
  
  <!-- EN: was blinded -->
  <BlindingCeremony_Self_Elevated.stages.was_blinded.label>kör edildi</BlindingCeremony_Self_Elevated.stages.was_blinded.label>
  <!-- EN: I was blinded in a righteous ceremony. Finally, I can start learning to see. -->
  <BlindingCeremony_Self_Elevated.stages.was_blinded.description>Kutsal bir törenle kör edildim. Sonunda görmeyi öğrenmeye başlayabilirim.</BlindingCeremony_Self_Elevated.stages.was_blinded.description>
  
