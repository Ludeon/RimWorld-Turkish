  <Blindness_Sublime_HalfBlind.stages.halfblind.description>Körlük yoluyla gerçek aydınlanmanın eşiğindeyim.</Blindness_Sublime_HalfBlind.stages.halfblind.description>
  
  <!-- EN: half-blind -->
  <Blindness_Sublime_HalfBlind_Social.stages.halfblind.label>yarı kör</Blindness_Sublime_HalfBlind_Social.stages.halfblind.label>
  
