<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: ate fungus raw -->
  <AteFungus_Despised.stages.ate_fungus_raw.label>çiğ mantar yedi</AteFungus_Despised.stages.ate_fungus_raw.label>
  <!-- EN: That fungus smelled like damp rags and tasted no better. -->
  <AteFungus_Despised.stages.ate_fungus_raw.description>O mantar nemli paçavra gibi kokuyordu, tadı da ondan iyi değildi.</AteFungus_Despised.stages.ate_fungus_raw.description>
  
  <!-- EN: ate fungus -->
  <AteFungus_Preferred.stages.ate_fungus.label>mantar yedi</AteFungus_Preferred.stages.ate_fungus.label>
  <!-- EN: I ate some fungus and it was just what I like! -->
  <AteFungus_Preferred.stages.ate_fungus.description>Biraz mantar yedim, tam sevdiğim gibiydi!</AteFungus_Preferred.stages.ate_fungus.description>
  
  <!-- EN: ate fungus cooked -->
  <AteFungusAsIngredient_Despised.stages.ate_fungus_cooked.label>pişmiş mantar yedi</AteFungusAsIngredient_Despised.stages.ate_fungus_cooked.label>
  <!-- EN: That whole meal smelled like a dead rat left in a stagnant pool. -->
  <AteFungusAsIngredient_Despised.stages.ate_fungus_cooked.description>Bütün yemek, durgun bir gölete bırakılmış ölü sıçan gibi kokuyordu.</AteFungusAsIngredient_Despised.stages.ate_fungus_cooked.description>
  
  <!-- EN: ate cooked fungus -->
  <AteFungusAsIngredient_Preferred.stages.ate_cooked_fungus.label>mantarlı yemek yedi</AteFungusAsIngredient_Preferred.stages.ate_cooked_fungus.label>
  <!-- EN: I ate a meal with fungus. Is there any dish it doesn't complement? -->
  <AteFungusAsIngredient_Preferred.stages.ate_cooked_fungus.description>Mantarlı bir yemek yedim. Yakışmadığı bir yemek var mı ki?</AteFungusAsIngredient_Preferred.stages.ate_cooked_fungus.description>
  
  <!-- EN: ate non-fungus plant cooked -->
  <AteNonFungusMealWithPlants_Despised.stages.ate_nonfungus_plant_cooked.label>mantarsız bitkisel yemek yedi</AteNonFungusMealWithPlants_Despised.stages.ate_nonfungus_plant_cooked.label>
  <!-- EN: I ate a meal with a plant of the light. I wish it were a fungus. -->
  <AteNonFungusMealWithPlants_Despised.stages.ate_nonfungus_plant_cooked.description>İçinde ışık bitkisi olan bir yemek yedim. Keşke mantar olsaydı.</AteNonFungusMealWithPlants_Despised.stages.ate_nonfungus_plant_cooked.description>
  
  <!-- EN: ate non-fungus plant raw -->
  <AteNonFungusPlant_Despised.stages.ate_nonfungus_plant_raw.label>mantar olmayan çiğ bitki yedi</AteNonFungusPlant_Despised.stages.ate_nonfungus_plant_raw.label>
  <!-- EN: I had to eat a non-fungus plant food I despise. I much prefer fungus. -->
  <AteNonFungusPlant_Despised.stages.ate_nonfungus_plant_raw.description>Hiç sevmediğim, mantar olmayan bir bitkisel yiyecek yemek zorunda kaldım. Mantarı çok daha fazla severim.</AteNonFungusPlant_Despised.stages.ate_nonfungus_plant_raw.description>
  
</LanguageData>