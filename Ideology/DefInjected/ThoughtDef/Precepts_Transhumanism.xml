<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: harmful aging -->
  <AgeReversalDemanded.stages.harmful_aging.label>zararlı yaşlanma</AgeReversalDemanded.stages.harmful_aging.label>
  <!-- EN: I'm getting old. I should get an age reversal in a biosculpter pod. -->
  <AgeReversalDemanded.stages.harmful_aging.description>Yaşlanıyorum. Biyoşekillendirme kapsülünde yaş geriletme yaptırmalıyım.</AgeReversalDemanded.stages.harmful_aging.description>
  <!-- EN: terrible aging -->
  <AgeReversalDemanded.stages.terrible_aging.label>berbat yaşlanma</AgeReversalDemanded.stages.terrible_aging.label>
  <!-- EN: My youth is draining away. I should get an age reversal in a biosculpter pod. -->
  <AgeReversalDemanded.stages.terrible_aging.description>Gençliğim akıp gidiyor. Biyoşekillendirme kapsülünde yaş geriletme yaptırmalıyım.</AgeReversalDemanded.stages.terrible_aging.description>
  <!-- EN: horrific aging -->
  <AgeReversalDemanded.stages.horrific_aging.label>korkunç yaşlanma</AgeReversalDemanded.stages.horrific_aging.label>
  <!-- EN: I am trapped in a decaying prison of flesh! I need to get an age reversal in a biosculpter pod. -->
  <AgeReversalDemanded.stages.horrific_aging.description>Çürüyen bir et hapishanesine kapana kısıldım! Biyoşekillendirme kapsülünde yaş geriletme yaptırmam gerek.</AgeReversalDemanded.stages.horrific_aging.description>
  
  <!-- EN: received age reversal -->
  <AgeReversalReceived.stages.received_age_reversal.label>yaş geriletme yaptırdı</AgeReversalReceived.stages.received_age_reversal.label>
  <!-- EN: Aging and death have no hold on me. I am forever, as an enhanced human ought to be. -->
  <AgeReversalReceived.stages.received_age_reversal.description>Yaşlılık ve ölüm üzerimde hiçbir güce sahip değil. Geliştirilmiş bir insana yakışır şekilde sonsuzum.</AgeReversalReceived.stages.received_age_reversal.description>
  
  <!-- EN: used biosculpter pod -->
  <BioSculpterDespised.stages.used_biosculpter_pod.label>biyoşekillendirme kapsülü kullandı</BioSculpterDespised.stages.used_biosculpter_pod.label>
  <!-- EN: My body was despoiled by the use of a biosculpter pod. -->
  <BioSculpterDespised.stages.used_biosculpter_pod.description>Biyoşekillendirme kapsülü kullanılarak bedenim kirletildi.</BioSculpterDespised.stages.used_biosculpter_pod.description>
  
  <!-- EN: want neural supercharge -->
  <NeedNeuralSupercharge.stages.want_neural_supercharge.label>sinirsel süper şarj istiyor</NeedNeuralSupercharge.stages.want_neural_supercharge.label>
  <!-- EN: Without a neural supercharge, I'm running below my true capacity. It's depressing. -->
  <NeedNeuralSupercharge.stages.want_neural_supercharge.description>Sinirsel süper şarj olmadan gerçek kapasitemin altında çalışıyorum. İç karartıcı.</NeedNeuralSupercharge.stages.want_neural_supercharge.description>
  
  <!-- EN: used sleep accelerator -->
  <SleptUsingSleepAccelerator.stages.used_sleep_accelerator.label>uyku hızlandırıcı kullandı</SleptUsingSleepAccelerator.stages.used_sleep_accelerator.label>
  <!-- EN: I slept with a sleep accelerator. It's helping me attain my true potential, as one should. -->
  <SleptUsingSleepAccelerator.stages.used_sleep_accelerator.description>Uyku hızlandırıcıyla uyudum. Olması gerektiği gibi gerçek potansiyelime ulaşmama yardım ediyor.</SleptUsingSleepAccelerator.stages.used_sleep_accelerator.description>
  
</LanguageData>