<?xml version="1.0" encoding="UTF-8"?>

<LanguageData>

  

  <!-- EN: ate twisted meat -->

  <AteTwistedMeat.stages.ate_twisted_meat.label>çarpık et yedim</AteTwistedMeat.stages.ate_twisted_meat.label>

  <!-- EN: It was so gristly and stringy - like eating cancer. I want to throw up. -->

  <AteTwistedMeat.stages.ate_twisted_meat.description>O kadar kıkırdaklı ve lifliydi ki... kanser yemek gibiydi. Kusacağım.</AteTwistedMeat.stages.ate_twisted_meat.description>

  

  <!-- EN: {0} became a ghoul -->

  <BecameGhoul.stages.became_a_ghoul.label>{0} gulyabaniye dönüştü</BecameGhoul.stages.became_a_ghoul.label>

  <!-- EN: That vacant look... Are they even in there anymore? -->

  <BecameGhoul.stages.became_a_ghoul.description>O bomboş bakış... Hâlâ orada biri var mı ki?</BecameGhoul.stages.became_a_ghoul.description>

  

  <!-- EN: bliss lobotomy -->

  <BlissLobotomy.stages.bliss_lobotomy.label>mutluluk lobotomisi</BlissLobotomy.stages.bliss_lobotomy.label>

  <!-- EN: Happy... good... happy... warm... -->

  <BlissLobotomy.stages.bliss_lobotomy.description>Mutlu... iyi... mutlu... sıcak...</BlissLobotomy.stages.bliss_lobotomy.description>

  

  <!-- EN: observed chimera -->

  <Chimera.stages.observed_chimera.label>kimera gördüm</Chimera.stages.observed_chimera.label>

  <!-- EN: That misshapen creature, the cracked whorled flesh... horrifying. -->

  <Chimera.stages.observed_chimera.description>O biçimsiz yaratık, o çatlak, girdaplı et... dehşet verici.</Chimera.stages.observed_chimera.description>

  

  <!-- EN: closed the void -->

  <ClosedTheVoid.stages.closed_the_void.label>boşluğu kapattım</ClosedTheVoid.stages.closed_the_void.label>

  <!-- EN: I can't believe it's finally over. -->

  <ClosedTheVoid.stages.closed_the_void.description>Sonunda bittiğine inanamıyorum.</ClosedTheVoid.stages.closed_the_void.description>

  

  <!-- EN: closed the void -->

  <ClosedTheVoidOpinion.stages.closed_the_void.label>boşluğu kapattı</ClosedTheVoidOpinion.stages.closed_the_void.label>

  

  <!-- EN: unnatural darkness lifted -->

  <DarknessLifted.stages.unnatural_darkness_lifted.label>doğaüstü karanlık dağıldı</DarknessLifted.stages.unnatural_darkness_lifted.label>

  <!-- EN: It's finally gone! I can breathe again. -->

  <DarknessLifted.stages.unnatural_darkness_lifted.description>Sonunda gitti! Yeniden nefes alabiliyorum.</DarknessLifted.stages.unnatural_darkness_lifted.description>

  

  <!-- EN: embraced the void -->

  <EmbracedTheVoid.stages.embraced_the_void.label>boşluğu kucakladım</EmbracedTheVoid.stages.embraced_the_void.label>

  <!-- EN: This is just the beginning. -->

  <EmbracedTheVoid.stages.embraced_the_void.description>Bu daha başlangıç.</EmbracedTheVoid.stages.embraced_the_void.description>

  

  <!-- EN: healed me -->

  <HealedMe.stages.healed_me.label>beni iyileştirdi</HealedMe.stages.healed_me.label>

  

  <!-- EN: {0} rambling -->

  <HeardInhumanRambling.stages.rambling.label>{0} saçmalıyor</HeardInhumanRambling.stages.rambling.label>

  <!-- EN: {OTHERPAWN_nameDef} is talking nonsense. Is {OTHERPAWN_pronoun} insane? -->

  <HeardInhumanRambling.stages.rambling.description>{OTHERPAWN_nameDef} saçma sapan konuşuyor. Delirdi mi?</HeardInhumanRambling.stages.rambling.description>

  

  <!-- EN: mutated my arm -->

  <MutatedMyArm.stages.mutated_my_arm.label>kolumu mutasyona uğrattı</MutatedMyArm.stages.mutated_my_arm.label>

  

  <!-- EN: obelisk abduction -->

  <ObeliskAbduction.stages.obelisk_abduction-0.label>dikilitaş tarafından kaçırıldım</ObeliskAbduction.stages.obelisk_abduction-0.label>

  <!-- EN: That horrible thing imprisoned me! -->

  <ObeliskAbduction.stages.obelisk_abduction-0.description>O korkunç şey beni hapsetti!</ObeliskAbduction.stages.obelisk_abduction-0.description>

  <!-- EN: obelisk abduction -->

  <ObeliskAbduction.stages.obelisk_abduction-1.label>dikilitaş tarafından kaçırıldım</ObeliskAbduction.stages.obelisk_abduction-1.label>

  <!-- EN: The sacred obelisk chose me! -->

  <ObeliskAbduction.stages.obelisk_abduction-1.description>Kutsal dikilitaş beni seçti!</ObeliskAbduction.stages.obelisk_abduction-1.description>

  

  <!-- EN: cube joy -->

  <PlayedWithCube.stages.cube_joy.label>küp keyfi</PlayedWithCube.stages.cube_joy.label>

  <!-- EN: My wonderful cube. My precious cube. I love it. It's so beautiful. -->

  <PlayedWithCube.stages.cube_joy.description>Harika küpüm. Kıymetli küpüm. Onu seviyorum. Öyle güzel ki.</PlayedWithCube.stages.cube_joy.description>

  

  <!-- EN: {RITUAL} guilt -->

  <PsychicRitualGuilt.stages.guilt-0.label>{RITUAL} suçluluğu</PsychicRitualGuilt.stages.guilt-0.label>

  <!-- EN: It feels wrong to have participated in that ritual. -->

  <PsychicRitualGuilt.stages.guilt-0.description>O ritüele katılmış olmak içime sinmiyor.</PsychicRitualGuilt.stages.guilt-0.description>

  <!-- EN: {RITUAL} guilt -->

  <PsychicRitualGuilt.stages.guilt-1.label>{RITUAL} suçluluğu</PsychicRitualGuilt.stages.guilt-1.label>

  <!-- EN: That ritual was a crime against its victim. I shouldn't have been there. -->

  <PsychicRitualGuilt.stages.guilt-1.description>O ritüel, kurbanına karşı işlenmiş bir suçtu. Orada olmamalıydım.</PsychicRitualGuilt.stages.guilt-1.description>

  <!-- EN: {RITUAL} guilt -->

  <PsychicRitualGuilt.stages.guilt-2.label>{RITUAL} suçluluğu</PsychicRitualGuilt.stages.guilt-2.label>

  <!-- EN: That ritual was nothing short of torture. It's evil! -->

  <PsychicRitualGuilt.stages.guilt-2.description>O ritüel düpedüz işkenceydi. Bu kötülük!</PsychicRitualGuilt.stages.guilt-2.description>

  

  <!-- EN: psychic ritual victim -->

  <PsychicRitualVictim.stages.psychic_ritual_victim.label>psişik ritüel kurbanı</PsychicRitualVictim.stages.psychic_ritual_victim.label>

  <!-- EN: They used me for their twisted ceremony. I'll never forget that horrid chanting. -->

  <PsychicRitualVictim.stages.psychic_ritual_victim.description>Beni o çarpık törenleri için kullandılar. O iğrenç ilahileri asla unutmayacağım.</PsychicRitualVictim.stages.psychic_ritual_victim.description>

  

  <!-- EN: unnatural corpse is angry -->

  <UnnaturalCorpseDestroyed.stages.unnatural_corpse_is_angry.label>doğaüstü ceset öfkeli</UnnaturalCorpseDestroyed.stages.unnatural_corpse_is_angry.label>

  <!-- EN: I can still feel the corpse. It's out there. It's thinking of me. It hates me. -->

  <UnnaturalCorpseDestroyed.stages.unnatural_corpse_is_angry.description>Cesedi hâlâ hissedebiliyorum. Orada bir yerde. Beni düşünüyor. Benden nefret ediyor.</UnnaturalCorpseDestroyed.stages.unnatural_corpse_is_angry.description>

  

  <!-- EN: void catharsis -->

  <VoidCatharsis.stages.void_catharsis.label>boşluk arınması</VoidCatharsis.stages.void_catharsis.label>

  <!-- EN: There was a madness building in my mind. It's gone, for now. -->

  <VoidCatharsis.stages.void_catharsis.description>Zihnimde bir delilik birikiyordu. Şimdilik geçti.</VoidCatharsis.stages.void_catharsis.description>

  

  <!-- EN: void closed -->

  <VoidClosed.stages.void_closed.label>boşluk kapandı</VoidClosed.stages.void_closed.label>

  <!-- EN: We can sleep easier now. Those things won't be coming back any time soon. -->

  <VoidClosed.stages.void_closed.description>Artık daha rahat uyuyabiliriz. O şeyler bir süre geri gelmeyecek.</VoidClosed.stages.void_closed.description>

  

  <!-- EN: Void curiosity -->

  <VoidCuriosity.stages.Void_curiosity.label>boşluk merakı</VoidCuriosity.stages.Void_curiosity.label>

  <!-- EN: We should perform a void provocation ritual. Who knows what phenomena we might discover? -->

  <VoidCuriosity.stages.Void_curiosity.description>Bir boşluk kışkırtması ritüeli yapmalıyız. Kim bilir ne olgular keşfedebiliriz?</VoidCuriosity.stages.Void_curiosity.description>

  

  <!-- EN: Void curiosity satisfied -->

  <VoidCuriositySatisfied.stages.Void_curiosity_satisfied.label>boşluk merakı giderildi</VoidCuriositySatisfied.stages.Void_curiosity_satisfied.label>

  <!-- EN: I regret nothing. -->

  <VoidCuriositySatisfied.stages.Void_curiosity_satisfied.description>Hiçbir şeyden pişman değilim.</VoidCuriositySatisfied.stages.Void_curiosity_satisfied.description>

  

</LanguageData>