<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>

  <!-- EN: dark visions -->
  <DarkVisions.label>karanlık görüler</DarkVisions.label>
  <!-- EN: Mental state: Dark visions -->
  <DarkVisions.baseInspectLine>Zihinsel durum: Karanlık görüler</DarkVisions.baseInspectLine>
  <!-- EN: {PAWN_nameDef} has become overwhelmed with horrible visions, rambling about things that only {PAWN_pronoun} can see. {PAWN_pronoun} will snap out of it in a few hours. -->
  <DarkVisions.beginLetter>{PAWN_nameDef} korkunç görülerin pençesine düştü; yalnızca kendisinin görebildiği şeyler hakkında sayıklıyor. Birkaç saat içinde kendine gelecek.</DarkVisions.beginLetter>
  <!-- EN: dark visions -->
  <DarkVisions.beginLetterLabel>karanlık görüler</DarkVisions.beginLetterLabel>
  <!-- EN: {PAWN_nameDef}'s dark visions have stopped. -->
  <DarkVisions.recoveryMessage>{PAWN_nameDef} için karanlık görüler sona erdi.</DarkVisions.recoveryMessage>

  <!-- EN: entity slayer -->
  <EntityKiller.label>varlık katili</EntityKiller.label>
  <!-- EN: Mental state: Entity slayer -->
  <EntityKiller.baseInspectLine>Zihinsel durum: Varlık katili</EntityKiller.baseInspectLine>
  <!-- EN: {0} has snapped. {PAWN_pronoun} can no longer tolerate holding such dangerous entities in captivity and intends to destroy as many as {PAWN_pronoun} can. -->
  <EntityKiller.beginLetter>{0} kendini kaybetti. Böylesine tehlikeli varlıkların esaret altında tutulmasına artık katlanamıyor ve yok edebildiği kadarını yok etmeye niyetli.</EntityKiller.beginLetter>
  <!-- EN: {0} is no longer slaughtering random entities. -->
  <EntityKiller.recoveryMessage>{0} artık rastgele varlıkları katletmiyor.</EntityKiller.recoveryMessage>

  <!-- EN: entity liberator -->
  <EntityLiberator.label>varlık kurtarıcısı</EntityLiberator.label>
  <!-- EN: Mental state: Entity liberator -->
  <EntityLiberator.baseInspectLine>Zihinsel durum: Varlık kurtarıcısı</EntityLiberator.baseInspectLine>
  <!-- EN: {0} has become suddenly allured by a captive entity and is convinced it must be freed. -->
  <EntityLiberator.beginLetter>{0} birden esir bir varlığa kapıldı ve onun serbest bırakılması gerektiğine inanıyor.</EntityLiberator.beginLetter>
  <!-- EN: {0} is no longer freeing entities. -->
  <EntityLiberator.recoveryMessage>{0} artık varlıkları serbest bırakmıyor.</EntityLiberator.recoveryMessage>

  <!-- EN: insane ramblings -->
  <InsaneRamblings.label>delice sayıklamalar</InsaneRamblings.label>
  <!-- EN: Mental state: Insane ramblings -->
  <InsaneRamblings.baseInspectLine>Zihinsel durum: Delice sayıklamalar</InsaneRamblings.baseInspectLine>
  <!-- EN: {PAWN_nameDef} has become completely untethered from reality, ranting about impossible subjects. {PAWN_pronoun} will snap out of it in a few hours. -->
  <InsaneRamblings.beginLetter>{PAWN_nameDef} gerçeklikle bağını tamamen kopardı; imkânsız konular hakkında atıp tutuyor. Birkaç saat içinde kendine gelecek.</InsaneRamblings.beginLetter>
  <!-- EN: insane ramblings -->
  <InsaneRamblings.beginLetterLabel>delice sayıklamalar</InsaneRamblings.beginLetterLabel>
  <!-- EN: {PAWN_nameDef} has stopped rambling. -->
  <InsaneRamblings.recoveryMessage>{PAWN_nameDef} sayıklamayı bıraktı.</InsaneRamblings.recoveryMessage>

  <!-- EN: terrifying hallucinations -->
  <TerrifyingHallucinations.label>dehşet verici halüsinasyonlar</TerrifyingHallucinations.label>
  <!-- EN: Mental state: Terrifying hallucinations -->
  <TerrifyingHallucinations.baseInspectLine>Zihinsel durum: Dehşet verici halüsinasyonlar</TerrifyingHallucinations.baseInspectLine>
  <!-- EN: Vivid  hallucinations swirl around {0}, twisting and distorting allies into horrifying abominations. {PAWN_pronoun} will flee from anyone {PAWN_pronoun} perceives as a threat. -->
  <TerrifyingHallucinations.beginLetter>{0} canlı halüsinasyonların girdabında; dostlarını korkunç iğrençliklere dönüşmüş, çarpılmış hâlde görüyor. Tehdit olarak algıladığı herkesten kaçacak.</TerrifyingHallucinations.beginLetter>
  <!-- EN: terrifying hallucinations -->
  <TerrifyingHallucinations.beginLetterLabel>dehşet verici halüsinasyonlar</TerrifyingHallucinations.beginLetterLabel>
  <!-- EN: {0} is no longer hallucinating. -->
  <TerrifyingHallucinations.recoveryMessage>{0} artık halüsinasyon görmüyor.</TerrifyingHallucinations.recoveryMessage>

</LanguageData>
