<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: ate without table -->
  <AteWithoutTable.stages.ate_without_table.label>masasız yemek yedi</AteWithoutTable.stages.ate_without_table.label>
  <!-- EN: I had to eat a meal off the ground. Can't we get a table around here? -->
  <AteWithoutTable.stages.ate_without_table.description>Yemeği yerden yemek zorunda kaldım. Buralarda bir masa bulamaz mıyız?</AteWithoutTable.stages.ate_without_table.description>
  
  <!-- EN: bonded animal {0} banished -->
  <BondedAnimalBanished.stages.bonded_animal_banished.label>bağ kurduğum hayvan {0} sürgün edildi</BondedAnimalBanished.stages.bonded_animal_banished.label>
  <!-- EN: My bonded animal was banished! -->
  <BondedAnimalBanished.stages.bonded_animal_banished.description>Bağ kurduğum hayvan sürgün edildi!</BondedAnimalBanished.stages.bonded_animal_banished.description>
  
  <!-- EN: I butchered humanlike -->
  <ButcheredHumanlikeCorpse.stages.I_butchered_humanlike.label>insansı birini kestim</ButcheredHumanlikeCorpse.stages.I_butchered_humanlike.label>
  <!-- EN: I butchered someone up like an animal. -->
  <ButcheredHumanlikeCorpse.stages.I_butchered_humanlike.description>Birini bir hayvan gibi parçaladım.</ButcheredHumanlikeCorpse.stages.I_butchered_humanlike.description>
  
  <!-- EN: butchered humanlike corpse -->
  <ButcheredHumanlikeCorpseOpinion.stages.butchered_humanlike_corpse.label>insansı ceset kesildi</ButcheredHumanlikeCorpseOpinion.stages.butchered_humanlike_corpse.label>
  
  <!-- EN: catharsis -->
  <Catharsis.stages.catharsis.label>katarsis</Catharsis.stages.catharsis.label>
  <!-- EN: It felt good to finally unbottle my feelings. -->
  <Catharsis.stages.catharsis.description>Sonunda duygularımı dışa vurmak iyi geldi.</Catharsis.stages.catharsis.description>
  
  <!-- EN: colonist banished -->
  <ColonistBanished.stages.colonist_banished.label>kolonist sürgün edildi</ColonistBanished.stages.colonist_banished.label>
  <!-- EN: We just banished someone. I hope they make it, but I'm worried. -->
  <ColonistBanished.stages.colonist_banished.description>Az önce birini sürgün ettik. Umarım başarır ama endişeliyim.</ColonistBanished.stages.colonist_banished.description>
  
  <!-- EN: colonist banished to death -->
  <ColonistBanishedToDie.stages.colonist_banished_to_death.label>kolonist ölüme sürgün edildi</ColonistBanishedToDie.stages.colonist_banished_to_death.label>
  <!-- EN: We banished someone in such a way that there's almost no way they'll survive. -->
  <ColonistBanishedToDie.stages.colonist_banished_to_death.description>Birini, hayatta kalma şansı neredeyse hiç olmayacak şekilde sürgün ettik.</ColonistBanishedToDie.stages.colonist_banished_to_death.description>
  
  <!-- EN: Colonist prisoner escaped -->
  <ColonyPrisonerEscaped.stages.Colonist_prisoner_escaped.label>koloni mahkûmu kaçtı</ColonyPrisonerEscaped.stages.Colonist_prisoner_escaped.label>
  <!-- EN: Can't we keep control of our own people? I feel like anything could happen to me here. -->
  <ColonyPrisonerEscaped.stages.Colonist_prisoner_escaped.description>Kendi insanlarımızı bile kontrol altında tutamıyor muyuz? Burada başıma her şey gelebilirmiş gibi hissediyorum.</ColonyPrisonerEscaped.stages.Colonist_prisoner_escaped.description>
  
  <!-- EN: defeated hostile leader {0} -->
  <DefeatedHostileFactionLeader.stages.defeated_hostile_leader.label>düşman lider {0} yenildi</DefeatedHostileFactionLeader.stages.defeated_hostile_leader.label>
  <!-- EN: They were leading efforts to destroy us, and I took them down! -->
  <DefeatedHostileFactionLeader.stages.defeated_hostile_leader.description>Bizi yok etme çabalarına önderlik ediyordu ve onu alaşağı ettim!</DefeatedHostileFactionLeader.stages.defeated_hostile_leader.description>
  
  <!-- EN: defeated hostile leader -->
  <DefeatedHostileFactionLeaderOpinion.stages.defeated_hostile_leader.label>düşman lider yenildi</DefeatedHostileFactionLeaderOpinion.stages.defeated_hostile_leader.label>
  
  <!-- EN: defeated insect hive -->
  <DefeatedInsectHive.stages.defeated_insect_hive.label>böcek kovanı yok edildi</DefeatedInsectHive.stages.defeated_insect_hive.label>
  <!-- EN: The only good bug is a dead bug! -->
  <DefeatedInsectHive.stages.defeated_insect_hive.description>İyi böcek, ölü böcektir!</DefeatedInsectHive.stages.defeated_insect_hive.description>
  
  <!-- EN: defeated mech cluster -->
  <DefeatedMechCluster.stages.defeated_mech_cluster.label>mek kümesi yok edildi</DefeatedMechCluster.stages.defeated_mech_cluster.label>
  <!-- EN: Blood beats metal, you damn machines! -->
  <DefeatedMechCluster.stages.defeated_mech_cluster.description>Kan metali yener, lanet makineler!</DefeatedMechCluster.stages.defeated_mech_cluster.description>
  
  <!-- EN: denied joining -->
  <DeniedJoining.stages.denied_joining.label>katılma talebi reddedildi</DeniedJoining.stages.denied_joining.label>
  <!-- EN: We just denied someone's request to join us. I hope they make it. -->
  <DeniedJoining.stages.denied_joining.description>Az önce birinin bize katılma isteğini reddettik. Umarım başının çaresine bakar.</DeniedJoining.stages.denied_joining.description>
  
  <!-- EN: failed to rescue {0} -->
  <FailedToRescueRelative.stages.failed_to_rescue.label>{0} kurtarılamadı</FailedToRescueRelative.stages.failed_to_rescue.label>
  <!-- EN: We had a chance to rescue my relative, and failed. I could have helped! -->
  <FailedToRescueRelative.stages.failed_to_rescue.description>Akrabamı kurtarma şansımız vardı ve başaramadık. Yardım edebilirdim!</FailedToRescueRelative.stages.failed_to_rescue.description>
  
  <!-- EN: freed from slavery -->
  <FreedFromSlavery.stages.freed_from_slavery.label>kölelikten kurtuldu</FreedFromSlavery.stages.freed_from_slavery.label>
  <!-- EN: I have been freed from slavery. I'm so thankful! -->
  <FreedFromSlavery.stages.freed_from_slavery.description>Kölelikten kurtuldum. Çok minnettarım!</FreedFromSlavery.stages.freed_from_slavery.description>
  
  <!-- EN: bloodlust organ harvested -->
  <HarvestedOrgan_Bloodlust.stages.bloodlust_organ_harvested.label>kana susamış organ hasadı</HarvestedOrgan_Bloodlust.stages.bloodlust_organ_harvested.label>
  <!-- EN: Extracting the flesh from their bodies is so bloody and satisfying. -->
  <HarvestedOrgan_Bloodlust.stages.bloodlust_organ_harvested.description>Bedenlerinden eti çıkarmak öyle kanlı ve tatmin edici ki.</HarvestedOrgan_Bloodlust.stages.bloodlust_organ_harvested.description>
  
  <!-- EN: killed someone -->
  <KilledHumanlikeBloodlust.stages.killed_someone.label>birini öldürdü</KilledHumanlikeBloodlust.stages.killed_someone.label>
  <!-- EN: I killed someone! What a rush! -->
  <KilledHumanlikeBloodlust.stages.killed_someone.description>Birini öldürdüm! Ne heyecan ama!</KilledHumanlikeBloodlust.stages.killed_someone.description>
  
  <!-- EN: buried in sarcophagus -->
  <KnowBuriedInSarcophagus.stages.buried_in_sarcophagus.label>lahite gömüldü</KnowBuriedInSarcophagus.stages.buried_in_sarcophagus.label>
  <!-- EN: This colony buried someone in an ornamented sarcophagus. May their soul rest in peace. -->
  <KnowBuriedInSarcophagus.stages.buried_in_sarcophagus.description>Bu koloni birini süslü bir lahite gömdü. Ruhu huzur içinde yatsın.</KnowBuriedInSarcophagus.stages.buried_in_sarcophagus.description>
  
  <!-- EN: we butchered humanlike -->
  <KnowButcheredHumanlikeCorpse.stages.we_butchered_humanlike.label>insansı birini kestik</KnowButcheredHumanlikeCorpse.stages.we_butchered_humanlike.label>
  <!-- EN: We butchered someone up like an animal. -->
  <KnowButcheredHumanlikeCorpse.stages.we_butchered_humanlike.description>Birini bir hayvan gibi parçaladık.</KnowButcheredHumanlikeCorpse.stages.we_butchered_humanlike.description>
  
  <!-- EN: colonist's organ harvested -->
  <KnowColonistOrganHarvested.stages.colonists_organ_harvested.label>kolonistin organı alındı</KnowColonistOrganHarvested.stages.colonists_organ_harvested.label>
  <!-- EN: Someone took body parts from a colonist. It's horrible, breaking someone down for parts when they have no choice. -->
  <KnowColonistOrganHarvested.stages.colonists_organ_harvested.description>Biri bir kolonistin vücut parçalarını aldı. Hiç seçme şansı olmayan birini parçaları için sökmek korkunç.</KnowColonistOrganHarvested.stages.colonists_organ_harvested.description>
  
  <!-- EN: someone's organ harvested -->
  <KnowGuestOrganHarvested.stages.someones_organ_harvested.label>birinin organı alındı</KnowGuestOrganHarvested.stages.someones_organ_harvested.label>
  <!-- EN: The colony took body parts from a guest or prisoner. It's horrible, breaking someone down for parts when they have no choice. -->
  <KnowGuestOrganHarvested.stages.someones_organ_harvested.description>Koloni bir misafirin ya da mahkûmun vücut parçalarını aldı. Hiç seçme şansı olmayan birini parçaları için sökmek korkunç.</KnowGuestOrganHarvested.stages.someones_organ_harvested.description>
  
  <!-- EN: prisoner sold -->
  <KnowPrisonerSold.stages.prisoner_sold.label>mahkûm satıldı</KnowPrisonerSold.stages.prisoner_sold.label>
  <!-- EN: This colony sold a prisoner into slavery. That's a worrying thought. -->
  <KnowPrisonerSold.stages.prisoner_sold.description>Bu koloni bir mahkûmu köle olarak sattı. Bu endişe verici bir düşünce.</KnowPrisonerSold.stages.prisoner_sold.description>
  
  <!-- EN: my organ harvested -->
  <MyOrganHarvested.stages.my_organ_harvested.label>organım alındı</MyOrganHarvested.stages.my_organ_harvested.label>
  <!-- EN: The colony harvested body parts from me! They're breaking me down like an old engine! -->
  <MyOrganHarvested.stages.my_organ_harvested.description>Koloni benden vücut parçaları aldı! Beni eski bir motor gibi söküyorlar!</MyOrganHarvested.stages.my_organ_harvested.description>
  
  <!-- EN: initial hope -->
  <NewColonyHope.stages.initial_hope.label>ilk umut</NewColonyHope.stages.initial_hope.label>
  <!-- EN: I'm getting used to this, but it's still an exciting new situation. I hope this works out... -->
  <NewColonyHope.stages.initial_hope.description>Buna alışıyorum ama yine de heyecan verici, yeni bir durum. Umarım işler yolunda gider...</NewColonyHope.stages.initial_hope.description>
  
  <!-- EN: initial optimism -->
  <NewColonyOptimism.stages.initial_optimism.label>ilk iyimserlik</NewColonyOptimism.stages.initial_optimism.label>
  <!-- EN: It's a tough situation, but I'm excited to be founding a new settlement. -->
  <NewColonyOptimism.stages.initial_optimism.description>Zor bir durum ama yeni bir yerleşim kuracak olmaktan heyecanlıyım.</NewColonyOptimism.stages.initial_optimism.description>
  
  <!-- EN: nuzzled -->
  <Nuzzled.stages.nuzzled-0.label>sokulma</Nuzzled.stages.nuzzled-0.label>
  <!-- EN: A cute animal nuzzled me. -->
  <Nuzzled.stages.nuzzled-0.description>Sevimli bir hayvan bana sokuldu.</Nuzzled.stages.nuzzled-0.description>
  <!-- EN: nuzzled -->
  <Nuzzled.stages.nuzzled-1.label>sokulma</Nuzzled.stages.nuzzled-1.label>
  <!-- EN: It is so cute, and supportive, and loving... I feel fulfilled and refreshed. -->
  <Nuzzled.stages.nuzzled-1.description>Öyle sevimli, öyle destekleyici ve sevgi dolu ki... Kendimi tamamlanmış ve tazelenmiş hissediyorum.</Nuzzled.stages.nuzzled-1.description>
  
  <!-- EN: observed corpse -->
  <ObservedLayingCorpse.stages.observed_corpse.label>ceset gördü</ObservedLayingCorpse.stages.observed_corpse.label>
  <!-- EN: I saw a dead body laying on the ground. It was disturbing. -->
  <ObservedLayingCorpse.stages.observed_corpse.description>Yerde yatan bir ceset gördüm. Rahatsız ediciydi.</ObservedLayingCorpse.stages.observed_corpse.description>
  
  <!-- EN: observed rotting corpse -->
  <ObservedLayingRottingCorpse.stages.observed_rotting_corpse.label>çürüyen ceset gördü</ObservedLayingRottingCorpse.stages.observed_rotting_corpse.label>
  <!-- EN: I saw a rotting corpse laying on the ground. It was disgusting. -->
  <ObservedLayingRottingCorpse.stages.observed_rotting_corpse.description>Yerde yatan çürümüş bir ceset gördüm. İğrençti.</ObservedLayingRottingCorpse.stages.observed_rotting_corpse.description>
  
  <!-- EN: on duty -->
  <OnDuty.stages.on_duty.label>görevde</OnDuty.stages.on_duty.label>
  <!-- EN: I have a job to do. -->
  <OnDuty.stages.on_duty.description>Yapmam gereken bir iş var.</OnDuty.stages.on_duty.description>
  
  <!-- EN: prisoner banished to death -->
  <PrisonerBanishedToDie.stages.prisoner_banished_to_death.label>mahkûm ölüme sürgün edildi</PrisonerBanishedToDie.stages.prisoner_banished_to_death.label>
  <!-- EN: We banished a prisoner in such a way that there's almost no way they'll survive. -->
  <PrisonerBanishedToDie.stages.prisoner_banished_to_death.description>Bir mahkûmu, hayatta kalma şansı neredeyse hiç olmayacak şekilde sürgün ettik.</PrisonerBanishedToDie.stages.prisoner_banished_to_death.description>
  
  <!-- EN: used flame weapon -->
  <PyroUsed.stages.used_flame_weapon.label>alev silahı kullandı</PyroUsed.stages.used_flame_weapon.label>
  <!-- EN: The searing heat will make my foes beautiful! -->
  <PyroUsed.stages.used_flame_weapon.description>Kavurucu sıcak düşmanlarımı güzelleştirecek!</PyroUsed.stages.used_flame_weapon.description>
  
  <!-- EN: prisoner released -->
  <ReleasedHealthyPrisoner.stages.prisoner_released.label>mahkûm serbest bırakıldı</ReleasedHealthyPrisoner.stages.prisoner_released.label>
  <!-- EN: We released a healthy prisoner. It feels good to know we even treat prisoners well. -->
  <ReleasedHealthyPrisoner.stages.prisoner_released.description>Sağlıklı bir mahkûmu serbest bıraktık. Mahkûmlara bile iyi davrandığımızı bilmek iyi hissettiriyor.</ReleasedHealthyPrisoner.stages.prisoner_released.description>
  
  <!-- EN: rescued -->
  <Rescued.stages.rescued.label>kurtarıldı</Rescued.stages.rescued.label>
  <!-- EN: I was rescued! I almost thought I was done for back there. I'm so thankful. -->
  <Rescued.stages.rescued.description>Kurtarıldım! Orada işimin bittiğini sanmıştım. Çok minnettarım.</Rescued.stages.rescued.description>
  
  <!-- EN: rescued {0} -->
  <RescuedRelative.stages.rescued.label>{0} kurtarıldı</RescuedRelative.stages.rescued.label>
  <!-- EN: We rescued one of my relatives. Finally, I can breathe a sigh of relief. -->
  <RescuedRelative.stages.rescued.description>Akrabalarımdan birini kurtardık. Sonunda rahat bir nefes alabiliyorum.</RescuedRelative.stages.rescued.description>
  
  <!-- EN: disturbed sleep -->
  <SleepDisturbed.stages.disturbed_sleep.label>uykusu bölündü</SleepDisturbed.stages.disturbed_sleep.label>
  <!-- EN: I was disturbed during sleep by people moving around nearby. A private room would solve this. -->
  <SleepDisturbed.stages.disturbed_sleep.description>Yakınımda dolaşan insanlar yüzünden uykum bölündü. Özel bir oda bu sorunu çözerdi.</SleepDisturbed.stages.disturbed_sleep.description>
  
  <!-- EN: slept in the cold -->
  <SleptInCold.stages.slept_in_the_cold.label>soğukta uyudu</SleptInCold.stages.slept_in_the_cold.label>
  <!-- EN: I had to sleep in the cold. We really need some heaters. -->
  <SleptInCold.stages.slept_in_the_cold.description>Soğukta uyumak zorunda kaldım. Gerçekten birkaç ısıtıcıya ihtiyacımız var.</SleptInCold.stages.slept_in_the_cold.description>
  
  <!-- EN: slept in the heat -->
  <SleptInHeat.stages.slept_in_the_heat.label>sıcakta uyudu</SleptInHeat.stages.slept_in_the_heat.label>
  <!-- EN: I had to sleep in unbearable heat. Can't we have air conditioning? -->
  <SleptInHeat.stages.slept_in_the_heat.description>Dayanılmaz bir sıcakta uyumak zorunda kaldım. Bir klimamız olamaz mı?</SleptInHeat.stages.slept_in_the_heat.description>
  
  <!-- EN: slept on ground -->
  <SleptOnGround.stages.slept_on_ground.label>yerde uyudu</SleptOnGround.stages.slept_on_ground.label>
  <!-- EN: I had to sleep on the ground like an animal. -->
  <SleptOnGround.stages.slept_on_ground.description>Bir hayvan gibi yerde uyumak zorunda kaldım.</SleptOnGround.stages.slept_on_ground.description>
  
  <!-- EN: slept outside -->
  <SleptOutside.stages.slept_outside.label>dışarıda uyudu</SleptOutside.stages.slept_outside.label>
  <!-- EN: I had to sleep outdoors without any protection from the elements. -->
  <SleptOutside.stages.slept_outside.description>Doğa koşullarına karşı hiçbir korunağım olmadan açık havada uyumak zorunda kaldım.</SleptOutside.stages.slept_outside.description>
  
  <!-- EN: soaking wet -->
  <SoakingWet.stages.soaking_wet.label>sırılsıklam</SoakingWet.stages.soaking_wet.label>
  <!-- EN: I'm soaking wet. -->
  <SoakingWet.stages.soaking_wet.description>Sırılsıklamım.</SoakingWet.stages.soaking_wet.description>
  
  <!-- EN: eager to travel -->
  <TravelAnticipation.stages.eager_to_travel.label>yolculuğa hevesli</TravelAnticipation.stages.eager_to_travel.label>
  <!-- EN: I've been preparing this caravan for a while. I'm looking forward to the upcoming journey. -->
  <TravelAnticipation.stages.eager_to_travel.description>Bir süredir bu kervanı hazırlıyorum. Yaklaşan yolculuğu dört gözle bekliyorum.</TravelAnticipation.stages.eager_to_travel.description>
  <!-- EN: excited to travel -->
  <TravelAnticipation.stages.excited_to_travel.label>yolculuk heyecanı</TravelAnticipation.stages.excited_to_travel.label>
  <!-- EN: So much thought and preparation have gone into this adventure. I can't wait to set off! -->
  <TravelAnticipation.stages.excited_to_travel.description>Bu maceraya o kadar çok düşünce ve hazırlık harcandı ki. Yola çıkmak için sabırsızlanıyorum!</TravelAnticipation.stages.excited_to_travel.description>
  
  <!-- EN: was imprisoned -->
  <WasImprisoned.stages.was_imprisoned.label>hapsedildi</WasImprisoned.stages.was_imprisoned.label>
  <!-- EN: The colony had me in jail for a while, like a caged animal. -->
  <WasImprisoned.stages.was_imprisoned.description>Koloni beni bir süre kafese kapatılmış bir hayvan gibi hapiste tuttu.</WasImprisoned.stages.was_imprisoned.description>
  
  <!-- EN: witnessed ally's death -->
  <WitnessedDeathAlly.stages.witnessed_allys_death.label>bir dostun ölümüne tanık oldu</WitnessedDeathAlly.stages.witnessed_allys_death.label>
  <!-- EN: I saw one of my people die. They were alive one moment, and dead the next. -->
  <WitnessedDeathAlly.stages.witnessed_allys_death.description>İnsanlarımızdan birinin ölümünü gördüm. Bir an hayattaydı, bir sonraki an ölüydü.</WitnessedDeathAlly.stages.witnessed_allys_death.description>
  
  <!-- EN: witnessed death with bloodlust -->
  <WitnessedDeathBloodlust.stages.witnessed_death_with_bloodlust.label>kana susamışlıkla ölüme tanık oldu</WitnessedDeathBloodlust.stages.witnessed_death_with_bloodlust.label>
  <!-- EN: I saw someone die! That was intense! -->
  <WitnessedDeathBloodlust.stages.witnessed_death_with_bloodlust.description>Birinin ölümünü gördüm! Müthişti!</WitnessedDeathBloodlust.stages.witnessed_death_with_bloodlust.description>
  
  <!-- EN: witnessed family member's death -->
  <WitnessedDeathFamily.stages.witnessed_family_members_death.label>aile üyesinin ölümüne tanık oldu</WitnessedDeathFamily.stages.witnessed_family_members_death.label>
  <!-- EN: I saw a member of my family die. My own flesh and blood... -->
  <WitnessedDeathFamily.stages.witnessed_family_members_death.description>Ailemden birinin ölümünü gördüm. Kendi kanımdan, canımdan...</WitnessedDeathFamily.stages.witnessed_family_members_death.description>
  
  <!-- EN: witnessed outsider's death -->
  <WitnessedDeathNonAlly.stages.witnessed_outsiders_death.label>bir yabancının ölümüne tanık oldu</WitnessedDeathNonAlly.stages.witnessed_outsiders_death.label>
  <!-- EN: I saw someone die. They were alive one moment, and dead the next. -->
  <WitnessedDeathNonAlly.stages.witnessed_outsiders_death.description>Birinin ölümünü gördüm. Bir an hayattaydı, bir sonraki an ölüydü.</WitnessedDeathNonAlly.stages.witnessed_outsiders_death.description>
  
</LanguageData>