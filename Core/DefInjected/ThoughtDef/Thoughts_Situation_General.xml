  <!-- EN: blistering hot -->
  <EnvironmentHot.stages.blistering_hot.label>kavurucu sıcak</EnvironmentHot.stages.blistering_hot.label>
  <!-- EN: This place is searing hot. I think I could die from this heat! -->
  <EnvironmentHot.stages.blistering_hot.description>Burası yakıp kavuruyor. Sanırım bu sıcaktan ölebilirim!</EnvironmentHot.stages.blistering_hot.description>
  
