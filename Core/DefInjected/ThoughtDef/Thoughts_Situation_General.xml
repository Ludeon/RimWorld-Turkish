  <!-- EN: chilly -->
  <EnvironmentCold.stages.chilly.label>serin</EnvironmentCold.stages.chilly.label>
  <!-- EN: I'm uncomfortably cold. -->
  <EnvironmentCold.stages.chilly.description>Rahatsız edici derecede üşüyorum.</EnvironmentCold.stages.chilly.description>
  <!-- EN: cold -->
  <EnvironmentCold.stages.cold.label>soğuk</EnvironmentCold.stages.cold.label>
  <!-- EN: I'm so cold, I'm shivering. -->
  <EnvironmentCold.stages.cold.description>Öyle üşüyorum ki titriyorum.</EnvironmentCold.stages.cold.description>
  <!-- EN: numbing cold -->
  <EnvironmentCold.stages.numbing_cold.label>uyuşturan soğuk</EnvironmentCold.stages.numbing_cold.label>
  <!-- EN: I can't stop shivering. My teeth are chattering. All I can think of is getting warm. -->
  <EnvironmentCold.stages.numbing_cold.description>Titremem durmuyor. Dişlerim takırdıyor. Tek düşünebildiğim ısınmak.</EnvironmentCold.stages.numbing_cold.description>
  <!-- EN: absolutely freezing -->
  <EnvironmentCold.stages.absolutely_freezing.label>buz gibi</EnvironmentCold.stages.absolutely_freezing.label>
  <!-- EN: My teeth are chattering so hard I can barely speak. My toes are numb. I need to get warm. -->
  <EnvironmentCold.stages.absolutely_freezing.description>Dişlerim öyle takırdıyor ki zar zor konuşabiliyorum. Ayak parmaklarım uyuştu. Isınmam lazım.</EnvironmentCold.stages.absolutely_freezing.description>
  
  <!-- EN: darkness -->
  <EnvironmentDark.stages.darkness.label>karanlık</EnvironmentDark.stages.darkness.label>
  <!-- EN: I've been in the dark for a while. I don't like it. -->
  <EnvironmentDark.stages.darkness.description>Bir süredir karanlıktayım. Hoşuma gitmiyor.</EnvironmentDark.stages.darkness.description>
  
  <!-- EN: sweaty -->
  <EnvironmentHot.stages.sweaty.label>terli</EnvironmentHot.stages.sweaty.label>
  <!-- EN: It's too hot here. I'm sweating. -->
  <EnvironmentHot.stages.sweaty.description>Burası çok sıcak. Terliyorum.</EnvironmentHot.stages.sweaty.description>
