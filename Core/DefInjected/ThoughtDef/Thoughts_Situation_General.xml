  <EnvironmentHot.stages.hot.label>sıcak</EnvironmentHot.stages.hot.label>
  <!-- EN: It's way too hot here. If I could just have a breath of cool air... -->
  <EnvironmentHot.stages.hot.description>Burası fazlasıyla sıcak. Bir nefes serin hava alabilsem...</EnvironmentHot.stages.hot.description>
  <!-- EN: sweltering hot -->
  <EnvironmentHot.stages.sweltering_hot.label>boğucu sıcak</EnvironmentHot.stages.sweltering_hot.label>
