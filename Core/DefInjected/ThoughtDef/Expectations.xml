<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: sky-high expectations -->
  <Expectations.stages.skyhigh_expectations.label>tavan yapmış beklentiler</Expectations.stages.skyhigh_expectations.label>
  <!-- EN: I should be made very comfortable here. -->
  <Expectations.stages.skyhigh_expectations.description>Burada bana çok rahat bir yaşam sağlanmalı.</Expectations.stages.skyhigh_expectations.description>
  <!-- EN: high expectations -->
  <Expectations.stages.high_expectations.label>yüksek beklentiler</Expectations.stages.high_expectations.label>
  <!-- EN: There's no reason I shouldn't have the things I want. -->
  <Expectations.stages.high_expectations.description>İstediğim şeylere sahip olmamam için hiçbir sebep yok.</Expectations.stages.high_expectations.description>
  <!-- EN: moderate expectations -->
  <Expectations.stages.moderate_expectations.label>makul beklentiler</Expectations.stages.moderate_expectations.label>
  <!-- EN: I can't expect to be totally pampered. -->
  <Expectations.stages.moderate_expectations.description>Tamamen el üstünde tutulmayı bekleyemem.</Expectations.stages.moderate_expectations.description>
  <!-- EN: low expectations -->
  <Expectations.stages.low_expectations.label>düşük beklentiler</Expectations.stages.low_expectations.label>
  <!-- EN: I can't expect great comforts. -->
  <Expectations.stages.low_expectations.description>Büyük konforlar bekleyemem.</Expectations.stages.low_expectations.description>
  <!-- EN: very low expectations -->
  <Expectations.stages.very_low_expectations.label>çok düşük beklentiler</Expectations.stages.very_low_expectations.label>
  <!-- EN: I need to keep myself strong to survive. -->
  <Expectations.stages.very_low_expectations.description>Hayatta kalmak için güçlü durmalıyım.</Expectations.stages.very_low_expectations.description>
  <!-- EN: extremely low expectations -->
  <Expectations.stages.extremely_low_expectations.label>son derece düşük beklentiler</Expectations.stages.extremely_low_expectations.label>
  <!-- EN: I'd better steel myself to survive. -->
  <Expectations.stages.extremely_low_expectations.description>Hayatta kalmak için dişimi sıksam iyi olur.</Expectations.stages.extremely_low_expectations.description>
  <!-- EN: noble expectations -->
  <Expectations.stages.noble_expectations.label>soylu beklentileri</Expectations.stages.noble_expectations.label>
  <!-- EN: I am above the little people and should be made happy every moment. -->
  <Expectations.stages.noble_expectations.description>Ben sıradan insanlardan üstünüm; her an mutlu edilmeliyim.</Expectations.stages.noble_expectations.description>
  <!-- EN: royal expectations -->
  <Expectations.stages.royal_expectations.label>kraliyet beklentileri</Expectations.stages.royal_expectations.label>
  <!-- EN: My majesty... I can hardly believe it myself. A moment's discomfort is below me. -->
  <Expectations.stages.royal_expectations.description>Haşmetim... Buna ben bile zor inanıyorum. Bir anlık rahatsızlık bile bana yakışmaz.</Expectations.stages.royal_expectations.description>
  <!-- EN: elite expectations -->
  <Expectations.stages.elite_expectations.label>seçkin beklentileri</Expectations.stages.elite_expectations.label>
  <!-- EN: I shouldn't have to endure any inconveniences that distract me from my important role. -->
  <Expectations.stages.elite_expectations.description>Önemli rolümden dikkatimi dağıtacak hiçbir rahatsızlığa katlanmak zorunda kalmamalıyım.</Expectations.stages.elite_expectations.description>
  <!-- EN: supreme expectations -->
  <Expectations.stages.supreme_expectations.label>yüce beklentiler</Expectations.stages.supreme_expectations.label>
  <!-- EN: My importance here is uncontested, so my comfort must be a critical priority for my people. -->
  <Expectations.stages.supreme_expectations.description>Buradaki önemim tartışılmaz; bu yüzden rahatım halkım için hayati bir öncelik olmalı.</Expectations.stages.supreme_expectations.description>
  
</LanguageData>