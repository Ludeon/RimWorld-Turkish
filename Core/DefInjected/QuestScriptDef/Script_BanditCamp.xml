  <!-- EN: Quest expired: [resolvedQuestName] -->

  <OpportunitySite_BanditCamp.LetterLabelQuestExpired.slateRef>Görevin süresi doldu: [resolvedQuestName]</OpportunitySite_BanditCamp.LetterLabelQuestExpired.slateRef>

  <!-- EN: The bandit camp has packed up and moved on. The quest [resolvedQuestName] has expired. -->

  <OpportunitySite_BanditCamp.LetterTextQuestExpired.slateRef>Haydut kampı toplanıp başka bir yere göçtü. [resolvedQuestName] görevinin süresi doldu.</OpportunitySite_BanditCamp.LetterTextQuestExpired.slateRef>

  <!-- EN: Quest failed: [resolvedQuestName] -->

  <OpportunitySite_BanditCamp.LetterLabelQuestFailed.slateRef>Görev başarısız: [resolvedQuestName]</OpportunitySite_BanditCamp.LetterLabelQuestFailed.slateRef>

  <!-- EN: After being discovered, the bandit camp has dispersed. The quest [resolvedQuestName] has ended. -->

  <OpportunitySite_BanditCamp.LetterTextQuestFailed.slateRef>Fark edildikten sonra haydut kampı dağıldı. [resolvedQuestName] görevi sona erdi.</OpportunitySite_BanditCamp.LetterTextQuestFailed.slateRef>

  <!-- EN: Payment arrived -->

  <OpportunitySite_BanditCamp.LetterLabelPaymentArrived.slateRef>Ödeme geldi</OpportunitySite_BanditCamp.LetterLabelPaymentArrived.slateRef>

  <!-- EN: You have defeated the bandit camp!\n\nThe payment from [asker_faction_name] has arrived. -->

  <OpportunitySite_BanditCamp.LetterTextPaymentArrived.slateRef>Haydut kampını yendin!\n\n[asker_faction_name] hizbinden gelen ödeme ulaştı.</OpportunitySite_BanditCamp.LetterTextPaymentArrived.slateRef>

  <!-- EN: [asker_faction_royalFavorLabel] -->

  <OpportunitySite_BanditCamp.LetterLabelFavorReceiver.slateRef>[asker_faction_royalFavorLabel]</OpportunitySite_BanditCamp.LetterLabelFavorReceiver.slateRef>

  <!-- EN: These colonists participated in the victory for the quest [resolvedQuestName]. [asker_definite] wants to know who should receive the [royalFavorReward_amount] [asker_faction_royalFavorLabel] for this service. -->

  <OpportunitySite_BanditCamp.LetterTextFavorReceiver.slateRef>Bu kolonistler [resolvedQuestName] görevindeki zafere katkıda bulundu. [asker_definite], bu hizmet karşılığındaki [royalFavorReward_amount] [asker_faction_royalFavorLabel] ödülünü kimin alacağını bilmek istiyor.</OpportunitySite_BanditCamp.LetterTextFavorReceiver.slateRef>

  

