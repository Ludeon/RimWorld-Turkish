<LanguageData>

  <!-- EN: Follow master while the master is drafted. -->
  <FollowDrafted.headerTip>Sahibi askere alındığında onu takip et.</FollowDrafted.headerTip>

  <!-- EN: Follow master while the master is doing field work (hunting or taming animals). -->
  <FollowFieldwork.headerTip>Sahibi saha işi yaparken (avlanma ya da hayvan evcilleştirme) onu takip et.</FollowFieldwork.headerTip>

  <!-- EN: Mark animals to be hunted by your hunters.\n\nOnly hunters with suitable ranged weapons will hunt. -->
  <Hunt.headerTip>Avcılarının avlaması için hayvanları işaretle.\n\nYalnızca uygun menzilli silahı olan avcılar avlanır.</Hunt.headerTip>

  <!-- EN: Release to wild -->
  <ReleaseAnimalToWild.headerTip>Doğaya sal</ReleaseAnimalToWild.headerTip>

  <!-- EN: Slaughter -->
  <Slaughter.headerTip>Kes</Slaughter.headerTip>

  <!-- EN: Sterilize -->
  <Sterile.headerTip>Kısırlaştır</Sterile.headerTip>

  <!-- EN: Tame a wild animal. -->
  <Tame.headerTip>Vahşi bir hayvanı evcilleştir.</Tame.headerTip>

</LanguageData>
